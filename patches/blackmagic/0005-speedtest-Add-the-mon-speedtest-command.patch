 src/meson.build |   1 +
 src/speedtest.c | 172 ++++++++++++++++++++++++++++++++++++++++++++++++
 src/speedtest.h |   7 ++
 4 files changed, 182 insertions(+)
 create mode 100644 src/speedtest.c
 create mode 100644 src/speedtest.h

