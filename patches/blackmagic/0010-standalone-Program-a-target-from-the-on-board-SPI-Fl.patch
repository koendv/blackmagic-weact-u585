+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Standalone programming: program a target from an image that `bmpflash provision` stored in the probe's
+ * on-board SPI Flash, without a host. Started by a long press on the user key, or by
+ * `monitor flasher write`.
+ *
+ * The image format is bmpflash's: the first 4KiB block of the SPI Flash holds the header, "BMPF", a CRC32
+ * of the whole block (computed with the CRC field set to 0xffffffff), the section count, then per section
+ * 16 bytes: offset in the SPI Flash, length and (64-bit) target address, all little endian.
+ *
+ * Programming scans SWD, then JTAG, attaches to each target found in turn (many target drivers only build
+ * their Flash map on attach) and programs the first one whose Flash holds every section: it erases all the
+ * section ranges, writes the sections, verifies them by reading them back, then resets and detaches.
+ */
+
+#include "general.h"
+#include "target.h"
+#include "target_internal.h"
+#include "gdb_main.h"
+#include "gdb_packet.h"
+#include "exception.h"
+#include "platform.h"
+#include "spi.h"
+#include "standalone.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define STANDALONE_HEADER_SIZE   4096U
+#define STANDALONE_HEADER_FIXED  12U
+#define STANDALONE_SECTION_SIZE  16U
+#define STANDALONE_MAX_SECTIONS  ((STANDALONE_HEADER_SIZE - STANDALONE_HEADER_FIXED) / STANDALONE_SECTION_SIZE)
+#define STANDALONE_CHUNK_SIZE    1024U
+#define STANDALONE_LONG_PRESS_MS 1000U
+#define STANDALONE_BLINK_MS      100U
+
+/* The result of a programming run; the error values are also the number of LED blinks */
+typedef enum standalone_result {
+	standalone_ok = 0,
+	standalone_err_image = 2,   /* no valid image in the SPI Flash */
+	standalone_err_target = 3,  /* no target, or not exactly one target whose Flash holds the image */
+	standalone_err_program = 4, /* erasing or writing the target's Flash failed */
+	standalone_err_verify = 5,  /* the target's Flash does not match the image */
+	standalone_err_comms = 6,   /* communication with the target failed */
+} standalone_result_e;
+
+typedef struct standalone_section {
+	uint32_t offset;
+	uint32_t length;
+	uint32_t address;
+} standalone_section_s;
+
+/* Whether output goes to GDB (monitor command) or to the AUX serial port (user key) */
+static bool standalone_via_gdb = false;
+static uint32_t standalone_led_toggled_ms = 0U;
+static bool standalone_led_on = false;
+
+static void standalone_output(const char *const buf, int len)
+{
+	if (len <= 0)
+		return;
+	if (standalone_via_gdb)
+		gdb_out(buf);
+	else {
+		debug_serial_send_stdout((const uint8_t *)buf, (size_t)len);
+		/* debug_serial_send_stdout() drops data while the previous USB packet is pending */
+		platform_delay(2U);
+	}
+}
+
+static void standalone_vlog(const char *const fmt, va_list args)
+{
+	char buf[96];
+	int len = vsnprintf(buf, sizeof(buf), fmt, args);
+	if (len >= (int)sizeof(buf))
+		len = (int)sizeof(buf) - 1;
+	standalone_output(buf, len);
+}
+
+static void standalone_log(const char *const fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	standalone_vlog(fmt, args);
+	va_end(args);
+}
+
+/* Messages from the target drivers go to the same place, never to a GDB session that may not be there */
+static void standalone_tc_printf(target_controller_s *const controller, const char *const fmt, va_list args)
+{
+	(void)controller;
+	standalone_vlog(fmt, args);
+}
+
+static void standalone_tc_destroy(target_controller_s *const controller, target_s *const target)
+{
+	(void)controller;
+	(void)target;
+}
+
+static target_controller_s standalone_controller = {
+	.destroy_callback = standalone_tc_destroy,
+	.printf = standalone_tc_printf,
+};
+
+/* Fast LED blinking shows programming is in progress */
+static void standalone_progress(void)
+{
+	const uint32_t now = platform_time_ms();
+	if (now - standalone_led_toggled_ms >= STANDALONE_BLINK_MS) {
+		standalone_led_toggled_ms = now;
+		standalone_led_on = !standalone_led_on;
+		platform_standalone_led(standalone_led_on);
+	}
+}
+
+static void standalone_show_result(const standalone_result_e result)
+{
+	if (result == standalone_ok) {
+		/* Success: the LED stays on for a while */
+		platform_standalone_led(true);
+		platform_delay(3000U);
+	} else {
+		/* Failure: the number of blinks gives the error, shown three times */
+		for (uint32_t repeat = 0U; repeat < 3U; ++repeat) {
+			for (uint32_t blink = 0U; blink < (uint32_t)result; ++blink) {
+				platform_standalone_led(true);
+				platform_delay(200U);
+				platform_standalone_led(false);
+				platform_delay(200U);
+			}
+			platform_delay(1000U);
+		}
+	}
+	platform_standalone_led_release();
+}
+
+static uint32_t standalone_read32(const uint8_t *const data)
+{
+	return (uint32_t)data[0] | ((uint32_t)data[1] << 8U) | ((uint32_t)data[2] << 16U) | ((uint32_t)data[3] << 24U);
+}
+
+/*
+ * The header CRC32: reflected polynomial 0xedb88320, final inversion, and a register starting at 0, as
+ * bmpflash inverts its 0xffffffff start value on entry. The CRC field counts as 0xffffffff.
+ */
+static uint32_t standalone_header_crc(const uint8_t *const header)
+{
+	uint32_t crc = 0U;
+	for (size_t idx = 0U; idx < STANDALONE_HEADER_SIZE; ++idx) {
+		crc ^= (idx >= 4U && idx < 8U) ? 0xffU : header[idx];
+		for (size_t bit = 0U; bit < 8U; ++bit)
+			crc = (crc >> 1U) ^ (0xedb88320U & (0U - (crc & 1U)));
+	}
+	return ~crc;
+}
+
+static standalone_section_s standalone_section(const uint8_t *const header, const uint32_t index)
+{
+	const uint8_t *const entry = header + STANDALONE_HEADER_FIXED + (index * STANDALONE_SECTION_SIZE);
+	const standalone_section_s section = {
+		.offset = standalone_read32(entry),
+		.length = standalone_read32(entry + 4U),
+		.address = standalone_read32(entry + 8U),
+	};
+	return section;
+}
+
+static void standalone_spi_read(const uint32_t offset, void *const buffer, const size_t length)
+{
+	bmp_spi_read(SPI_BUS_INTERNAL, SPI_DEVICE_INT_FLASH, SPI_FLASH_CMD_PAGE_READ, offset, buffer, length);
+}
+
+/* Read the image header and check it; returns the section count, or 0 for no valid image */
+static uint32_t standalone_read_image(uint8_t *const header)
+{
+	standalone_spi_read(0U, header, STANDALONE_HEADER_SIZE);
+	if (memcmp(header, "BMPF", 4U) != 0) {
+		standalone_log("No image in the SPI Flash (use bmpflash provision)\n");
+		return 0U;
+	}
+	if (standalone_read32(header + 4U) != standalone_header_crc(header)) {
+		standalone_log("Image header CRC mismatch\n");
+		return 0U;
+	}
+	const uint32_t count = standalone_read32(header + 8U);
+	if (count == 0U || count > STANDALONE_MAX_SECTIONS) {
+		standalone_log("Invalid section count %" PRIu32 "\n", count);
+		return 0U;
+	}
+	for (uint32_t idx = 0U; idx < count; ++idx) {
+		const standalone_section_s section = standalone_section(header, idx);
+		const uint8_t *const entry = header + STANDALONE_HEADER_FIXED + (idx * STANDALONE_SECTION_SIZE);
+		/* The target address is 64 bits wide in the image; only 32-bit targets are supported */
+		if (section.offset < STANDALONE_HEADER_SIZE || section.length == 0U || standalone_read32(entry + 12U) != 0U ||
+			section.address + section.length < section.address) {
+			standalone_log("Invalid section %" PRIu32 "\n", idx);
+			return 0U;
+		}
+	}
+	return count;
+}
+
+static bool standalone_target_holds_image(target_s *const target, const uint8_t *const header, const uint32_t count)
+{
+	for (uint32_t idx = 0U; idx < count; ++idx) {
+		const standalone_section_s section = standalone_section(header, idx);
+		if (!target_flash_for_addr(target, section.address) ||
+			!target_flash_for_addr(target, section.address + section.length - 1U)) {
+			standalone_log("%s: section %" PRIu32 " at 0x%08" PRIx32 " is not in its Flash\n", target->driver, idx,
+				section.address);
+			return false;
+		}
+	}
+	return true;
+}
+
+static void standalone_count_target(const size_t index, target_s *const target, void *const context)
+{
+	(void)index;
+	(void)target;
+	++*(size_t *)context;
+}
+
+/* Scan SWD first, then JTAG; returns true if targets were found */
+static bool standalone_scan(void)
+{
+	/* volatile: changed inside TRY blocks, which use setjmp/longjmp */
+	volatile bool found = false;
+	{
+		TRY (EXCEPTION_ALL) {
+			found = adiv5_swd_scan();
+		}
+		CATCH () {
+		default:
+			found = false;
+			break;
+		}
+	}
+	if (found)
+		return true;
+	{
+		TRY (EXCEPTION_ALL) {
+			found = jtag_scan();
+		}
+		CATCH () {
+		default:
+			found = false;
+			break;
+		}
+	}
+	return found;
+}
+
+static standalone_result_e standalone_write_target(
+	target_s *const target, const uint8_t *const header, const uint32_t count, uint8_t *const buffer)
+{
+	/* Erase every section range before writing anything: sections can share a Flash sector */
+	for (uint32_t idx = 0U; idx < count; ++idx) {
+		const standalone_section_s section = standalone_section(header, idx);
+		standalone_progress();
+		if (!target_flash_erase(target, section.address, section.length)) {
+			standalone_log("Erase failed at 0x%08" PRIx32 "\n", section.address);
+			return standalone_err_program;
+		}
+	}
+
+	for (uint32_t idx = 0U; idx < count; ++idx) {
+		const standalone_section_s section = standalone_section(header, idx);
+		for (uint32_t done = 0U; done < section.length; done += STANDALONE_CHUNK_SIZE) {
+			const uint32_t amount = MIN(section.length - done, STANDALONE_CHUNK_SIZE);
+			standalone_progress();
+			standalone_spi_read(section.offset + done, buffer, amount);
+			if (!target_flash_write(target, section.address + done, buffer, amount)) {
+				standalone_log("Write failed at 0x%08" PRIx32 "\n", section.address + done);
+				return standalone_err_program;
+			}
+		}
+	}
+	if (!target_flash_complete(target)) {
+		standalone_log("Write failed\n");
+		return standalone_err_program;
+	}
+
+	/* Verify by reading every section back */
+	uint8_t *const readback = buffer + STANDALONE_CHUNK_SIZE;
+	for (uint32_t idx = 0U; idx < count; ++idx) {
+		const standalone_section_s section = standalone_section(header, idx);
+		for (uint32_t done = 0U; done < section.length; done += STANDALONE_CHUNK_SIZE) {
+			const uint32_t amount = MIN(section.length - done, STANDALONE_CHUNK_SIZE);
+			standalone_progress();
+			standalone_spi_read(section.offset + done, buffer, amount);
+			if (target_mem32_read(target, readback, section.address + done, amount) ||
+				memcmp(buffer, readback, amount) != 0) {
+				standalone_log("Verify failed at 0x%08" PRIx32 "\n", section.address + done);
+				return standalone_err_verify;
+			}
+		}
+	}
+	return standalone_ok;
+}
+
+/*
+ * Attach to target number `number` (counting from 1) and, if its Flash holds the image, program it.
+ * `*selected` tells whether this target was the one to program; if not, the result is meaningless.
+ */
+static standalone_result_e standalone_program_target(const size_t number, const uint8_t *const header,
+	const uint32_t count, uint8_t *const buffer, bool *const selected)
+{
+	/* volatile: changed inside TRY blocks, which use setjmp/longjmp */
+	volatile standalone_result_e result = standalone_err_target;
+	volatile bool holds_image = false;
+	target_s *volatile target = NULL;
+	{
+		TRY (EXCEPTION_ALL) {
+			target = target_attach_n(number, &standalone_controller);
+			if (!target)
+				standalone_log("Target %u: attach failed\n", (unsigned)number);
+			/* Many target drivers only build their Flash map on attach, so check it now */
+			if (target && standalone_target_holds_image(target, header, count)) {
+				holds_image = true;
+				standalone_log("Programming %s\n", target->driver);
+				result = standalone_write_target(target, header, count, buffer);
+			}
+		}
+		CATCH () {
+		default:
+			standalone_log("Target %u: communication failed: %s\n", (unsigned)number,
+				exception_frame.msg ? exception_frame.msg : "unknown error");
+			result = standalone_err_comms;
+			break;
+		}
+	}
+	if (target) {
+		TRY (EXCEPTION_ALL) {
+			/* Start the new program */
+			if (holds_image && result == standalone_ok)
+				target_reset(target);
+			target_detach(target);
+		}
+		CATCH () {
+		default:
+			break;
+		}
+	}
+	*selected = holds_image;
+	return result;
+}
+
+static standalone_result_e standalone_program_image(uint8_t *const header, uint8_t *const buffer)
+{
+	const uint32_t count = standalone_read_image(header);
+	if (!count)
+		return standalone_err_image;
+	standalone_log("Image: %" PRIu32 " sections\n", count);
+
+	if (!standalone_scan()) {
+		standalone_log("No target found\n");
+		return standalone_err_target;
+	}
+	/* Program the first target whose Flash holds the image (cores of one chip share their Flash map) */
+	size_t targets = 0U;
+	target_foreach(standalone_count_target, &targets);
+	standalone_log("Found %u target%s\n", (unsigned)targets, targets == 1U ? "" : "s");
+	for (size_t number = 1U; number <= targets; ++number) {
+		bool selected = false;
+		const standalone_result_e result = standalone_program_target(number, header, count, buffer, &selected);
+		if (selected)
+			return result;
+	}
+	standalone_log("No target's Flash holds the image\n");
+	return standalone_err_target;
+}
+
+static standalone_result_e standalone_program(void)
+{
+	uint8_t *const header = malloc(STANDALONE_HEADER_SIZE);
+	uint8_t *const buffer = malloc(2U * STANDALONE_CHUNK_SIZE);
+	standalone_result_e result = standalone_err_image;
+	if (!header || !buffer)
+		standalone_log("Out of memory\n");
+	else if (!platform_spi_init(SPI_BUS_INTERNAL))
+		standalone_log("SPI Flash not available\n");
+	else {
+		result = standalone_program_image(header, buffer);
+		platform_spi_deinit(SPI_BUS_INTERNAL);
+	}
+	/* The scan replaced the target list; start any later GDB session from a clean state */
+	target_list_free();
+	free(buffer);
+	free(header);
+	standalone_log(result == standalone_ok ? "Programming done\n" : "Programming failed\n");
+	return result;
+}
+
+void standalone_poll(void)
+{
+	static uint32_t pressed_since = 0U;
+	/* The key must be released first, so holding it at power-up or after a run does nothing */
+	static bool released = false;
+
+	const bool pressed = platform_standalone_key_pressed();
+	if (!pressed) {
+		released = true;
+		pressed_since = 0U;
+		return;
+	}
+	/* Never while a GDB session is attached to a target */
+	if (!released || cur_target)
+		return;
+	const uint32_t now = platform_time_ms();
+	if (!pressed_since) {
+		pressed_since = now | 1U;
+		return;
+	}
+	if (now - pressed_since < STANDALONE_LONG_PRESS_MS)
+		return;
+
+	released = false;
+	pressed_since = 0U;
+	standalone_via_gdb = false;
+	standalone_led_toggled_ms = now;
+	standalone_led_on = false;
+	standalone_show_result(standalone_program());
+}
+
+static bool standalone_info(void)
+{
+	uint8_t *const header = malloc(STANDALONE_HEADER_SIZE);
+	bool result = false;
+	if (!header)
+		standalone_log("Out of memory\n");
+	else if (!platform_spi_init(SPI_BUS_INTERNAL))
+		standalone_log("SPI Flash not available\n");
+	else {
+		const uint32_t count = standalone_read_image(header);
+		for (uint32_t idx = 0U; idx < count; ++idx) {
+			const standalone_section_s section = standalone_section(header, idx);
+			standalone_log("%3" PRIu32 ": 0x%08" PRIx32 " %6" PRIu32 " bytes\n", idx, section.address, section.length);
+		}
+		result = count != 0U;
+		platform_spi_deinit(SPI_BUS_INTERNAL);
+	}
+	free(header);
+	return result;
+}
+
+bool cmd_standalone(target_s *const target, const int argc, const char **const argv)
+{
+	const bool write = argc == 2 && strcmp(argv[1], "write") == 0;
+	if (argc > 2 || (argc == 2 && !write && strcmp(argv[1], "info") != 0)) {
+		gdb_out("usage: monitor flasher [info|write]\n");
+		return false;
+	}
+	standalone_via_gdb = true;
+	if (!write)
+		return standalone_info();
+	if (target) {
+		gdb_out("Detach from the target first\n");
+		return false;
+	}
+	standalone_led_toggled_ms = platform_time_ms();
+	standalone_led_on = false;
+	const standalone_result_e result = standalone_program();
+	platform_standalone_led_release();
+	return result == standalone_ok;
+}
