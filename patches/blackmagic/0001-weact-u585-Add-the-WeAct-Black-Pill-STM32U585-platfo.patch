+
+#include "general.h"
+#include "platform.h"
+#include "usb.h"
+#include "rcc_clocking.h"
+#include "aux_serial.h"
+
+#include <libopencm3/cm3/vector.h>
+#include <libopencm3/cm3/scb.h>
+#include <libopencm3/cm3/scs.h>
+#include <libopencm3/usb/dwc/otg_fs.h>
+#include <libopencm3/usb/dwc/otg_common.h>
+#include <libopencm3/stm32/rcc.h>
+#include <libopencm3/stm32/crs.h>
+#include <libopencm3/stm32/pwr.h>
+#include <libopencm3/stm32/gpio.h>
+#include <libopencm3/stm32/spi.h>
+
+/* RM0456: OTG_GOTGCTL B-peripheral session valid override enable/value */
+#ifndef OTG_GOTGCTL_BVALOEN
+#define OTG_GOTGCTL_BVALOEN (1U << 6U)
+#endif
+#ifndef OTG_GOTGCTL_BVALOVAL
+#define OTG_GOTGCTL_BVALOVAL (1U << 7U)
+#endif
+
+/* RM0456: PWR_DBPR disable backup domain write protection */
+#ifndef PWR_DBPR_DBP
+#define PWR_DBPR_DBP (1U << 0U)
+#endif
+
+/* RM0456: RCC_BDCR LSE oscillator drive capability */
+#ifndef RCC_BDCR_LSEDRV_SHIFT
+#define RCC_BDCR_LSEDRV_SHIFT       3U
+#define RCC_BDCR_LSEDRV_MASK        (3U << RCC_BDCR_LSEDRV_SHIFT)
+#define RCC_BDCR_LSEDRV_MEDIUM_HIGH (2U << RCC_BDCR_LSEDRV_SHIFT)
+#endif
+
+/* Crystal start-up timeouts in milliseconds, the same as ST's HAL defaults (HSE_STARTUP_TIMEOUT, LSE_STARTUP_TIMEOUT) */
+#define HSE_STARTUP_TIMEOUT_MS 100U
+#define LSE_STARTUP_TIMEOUT_MS 5000U
+
+/* Number of LED blinks signalling a crystal that did not start */
+#define HSE_FAIL_BLINKS 3U
+#define LSE_FAIL_BLINKS 2U
+
+/* Magic values stored across a system reset to request entry into the ROM bootloader */
+#define BOOTMAGIC0 UINT32_C(0xb007da7a)
+#define BOOTMAGIC1 UINT32_C(0xbaadfeed)
+
+/* Lives in SRAM3 (see the linker script), which keeps its contents across the reset in platform_request_boot() */
+static volatile uint32_t magic[2] __attribute__((section(".noinit")));
+
+static void platform_check_rom_bootloader_request(void);
+static void crystals_start(void);
+static void crystals_check(void);
+static void gpio_init(void);
+
+void platform_init(void)
+{
+	/* Must run first, while the chip is still in its post-reset state */
+	platform_check_rom_bootloader_request();
+
+	SCS_DEMCR |= SCS_DEMCR_VC_MON_EN;
+
+	/* Enable the FPU as we're in hard float mode and defined it to the compiler */
+	SCB_CPACR |= SCB_CPACR_CP10_FULL | SCB_CPACR_CP11_FULL;
+
+	/* Set up the NVIC vector table for the firmware */
+	SCB_VTOR = (uintptr_t)&vector_table; // NOLINT(clang-diagnostic-pointer-to-int-cast, performance-no-int-to-ptr)
+
+	/* Bring up the PLLs, set up HSI48 for USB, and set up the clock recovery system for that */
+	rcc_clock_setup_pll(&rcc_hsi_config);
+	rcc_clock_setup_hsi48();
+	crs_autotrim_usb_enable();
+	/* Power up USB controller */
+	pwr_enable_vddusb();
+	/* Power up the analog domain */
+	pwr_enable_vdda();
+	/* Route HSI48 to the USB controller */
+	rcc_set_iclk_clksel(RCC_CCIPR1_ICLKSEL_HSI48);
+
+	/* Start the crystal oscillators, they get checked once the timing subsystem is up */
+	crystals_start();
+
+	/* Enable peripherals */
+	rcc_periph_clock_enable(RCC_OTGFS);
+	rcc_periph_clock_enable(RCC_CRS);
+	rcc_periph_clock_enable(RCC_GPIOA);
+	rcc_periph_clock_enable(RCC_GPIOB);
+	rcc_periph_clock_enable(RCC_GPIOC);
+	/* Make sure to power up the timer used for trace */
+	rcc_periph_clock_enable(RCC_TIM5);
+	rcc_periph_clock_enable(RCC_CRC);
+
+	/* Setup GPIO ports */
+	gpio_init();
+
+	/* Bring up timing, check the crystals came up, then bring up USB */
+	platform_timing_init();
+	crystals_check();
+	blackmagic_usb_init();
+
+	/*
+	 * This board has no VBUS sense connection to the MCU, so disable VBUS detection and
+	 * override the B-session valid signal so the core will connect (RM0456: OTG_GCCFG.VBDEN,
+	 * OTG_GOTGCTL.BVALOEN and OTG_GOTGCTL.BVALOVAL)
+	 */
+	OTG_FS_GCCFG &= ~OTG_GCCFG_VBDEN;
+	OTG_FS_GOTGCTL |= OTG_GOTGCTL_BVALOEN | OTG_GOTGCTL_BVALOVAL;
+
+	/* Bring up the aux serial interface */
+	aux_serial_init();
+}
+
+/*
+ * Enter the STM32 ROM (system memory) bootloader, which provides USB DFU, if platform_request_boot()
+ * asked for it (a DFU detach request). The U5 has no SYSCFG memory remap, so jump to the ROM directly.
+ * Without a running firmware, BOOT0 + NRST enters the ROM bootloader too.
+ */
+static void platform_check_rom_bootloader_request(void)
+{
+	const bool boot_requested = magic[0] == BOOTMAGIC0 && magic[1] == BOOTMAGIC1;
+	magic[0] = 0U;
+	magic[1] = 0U;
+	if (!boot_requested)
+		return;
+
+	/* Load the ROM bootloader's stack pointer and reset vector, and jump to it */
+	SCB_VTOR = SYSTEM_MEM_BASE;
+	const uint32_t stack_pointer = *((const volatile uint32_t *)SYSTEM_MEM_BASE);
+	/* clang-format off */
+	__asm__ volatile(
+		"msr msp, %1\n"     /* Load the system stack register with the ROM's stack pointer */
+		"ldr pc, [%0, 4]\n" /* Jump to the ROM bootloader's reset vector */
+		: : "l"(SYSTEM_MEM_BASE), "l"(stack_pointer) : "memory");
+	/* clang-format on */
+	__builtin_unreachable();
+}
+
+/*
+ * Start the 25MHz HSE and 32.768kHz LSE crystal oscillators. Nothing is clocked from them yet,
+ * they are started so a missing or broken crystal gets noticed.
+ */
+static void crystals_start(void)
+{
+	rcc_osc_on(RCC_HSE);
+
+	/* The LSE lives in the backup domain, which is write protected after reset */
+	rcc_periph_clock_enable(RCC_PWR);
+	PWR_DBPR |= PWR_DBPR_DBP;
+	/* The backup domain survives a system reset, so the LSE may already be running */
+	if (!(RCC_BDCR & RCC_BDCR_LSEON)) {
+		/* The drive level may only be changed while the LSE is off */
+		RCC_BDCR = (RCC_BDCR & ~(RCC_BDCR_LSEDRV_MASK | RCC_BDCR_LSEBYP)) | RCC_BDCR_LSEDRV_MEDIUM_HIGH;
+		RCC_BDCR |= RCC_BDCR_LSEON;
+	}
+}
+
+static bool crystal_wait_ready(const enum rcc_osc osc, const uint32_t timeout_ms)
+{
+	platform_timeout_s timeout;
+	platform_timeout_set(&timeout, timeout_ms);
+	while (!rcc_is_osc_ready(osc)) {
+		if (platform_timeout_is_expired(&timeout))
+			return rcc_is_osc_ready(osc);
+	}
+	return true;
+}
+
+static bool lse_wait_ready(const uint32_t timeout_ms)
+{
+	platform_timeout_s timeout;
+	platform_timeout_set(&timeout, timeout_ms);
+	while (!(RCC_BDCR & RCC_BDCR_LSERDY)) {
+		if (platform_timeout_is_expired(&timeout))
+			return RCC_BDCR & RCC_BDCR_LSERDY;
+	}
+	return true;
+}
+
+/* Blink the LED count times, then pause, to signal a fault */
+static void led_blink(const uint32_t count)
+{
+	for (uint32_t blink = 0U; blink < count; ++blink) {
+		gpio_clear(LED0_PORT, LED0_PIN); /* LED on */
+		platform_delay(200U);
+		gpio_set(LED0_PORT, LED0_PIN); /* LED off */
+		platform_delay(200U);
+	}
+	platform_delay(1000U);
+}
+
+/*
+ * Check both crystals started. A failed crystal is not fatal: the LED blinks 3 times for
+ * the HSE and 2 times for the LSE, then the firmware carries on.
+ */
+static void crystals_check(void)
+{
+	const bool hse_ok = crystal_wait_ready(RCC_HSE, HSE_STARTUP_TIMEOUT_MS);
+	const bool lse_ok = lse_wait_ready(LSE_STARTUP_TIMEOUT_MS);
+	if (!hse_ok) {
+		DEBUG_WARN("HSE crystal did not start\n");
+		led_blink(HSE_FAIL_BLINKS);
+	}
+	if (!lse_ok) {
+		DEBUG_WARN("LSE crystal did not start\n");
+		led_blink(LSE_FAIL_BLINKS);
+	}
+}
+
+static void gpio_init(void)
+{
+	/*
+	 * Configure the pins used to interface to the debug interface of a target. Unlike BMPv3 these
+	 * pins drive the target wiring directly, with no buffers, so use the slowest output speed: faster
+	 * edges ring on jumper wires and corrupt SWD. Low speed still handles the fastest bit-banged clock.
+	 */
+	gpio_set_output_options(TCK_PORT, GPIO_OTYPE_PP, GPIO_OSPEED_2MHZ, TCK_PIN);
+	gpio_mode_setup(TCK_PORT, GPIO_MODE_OUTPUT, GPIO_PUPD_NONE, TCK_PIN);
+	gpio_set_output_options(TMS_PORT, GPIO_OTYPE_PP, GPIO_OSPEED_2MHZ, TMS_PIN);
+	gpio_mode_setup(TMS_PORT, GPIO_MODE_INPUT, GPIO_PUPD_NONE, TMS_PIN);
+	gpio_set_output_options(TDI_PORT, GPIO_OTYPE_PP, GPIO_OSPEED_2MHZ, TDI_PIN);
+	gpio_mode_setup(TDI_PORT, GPIO_MODE_OUTPUT, GPIO_PUPD_NONE, TDI_PIN);
+	gpio_mode_setup(TDO_PORT, GPIO_MODE_INPUT, GPIO_PUPD_NONE, TDO_PIN);
+
+	/*
+	 * nRST is open drain so the target can pull its own reset low and we can sense that,
+	 * with the internal pull-up keeping the line defined when no target is connected
+	 */
+	gpio_set(NRST_PORT, NRST_PIN);
+	gpio_set_output_options(NRST_PORT, GPIO_OTYPE_OD, GPIO_OSPEED_25MHZ, NRST_PIN);
+	gpio_mode_setup(NRST_PORT, GPIO_MODE_OUTPUT, GPIO_PUPD_PULLUP, NRST_PIN);
+
+	/* Configure the pin used to drive the user LED (PC13, active low), starting off */
+	gpio_set(LED0_PORT, LED0_PIN);
+	gpio_set_output_options(LED0_PORT, GPIO_OTYPE_PP, GPIO_OSPEED_2MHZ, LED0_PIN);
+	gpio_mode_setup(LED0_PORT, GPIO_MODE_OUTPUT, GPIO_PUPD_NONE, LED0_PIN);
+
+	/* Configure the first UART used for the AUX serial interface */
+	gpio_set_af(AUX_UART1_PORT, GPIO_AF7, AUX_UART1_TX_PIN | AUX_UART1_RX_PIN);
+	gpio_set_output_options(AUX_UART1_PORT, GPIO_OTYPE_PP, GPIO_OSPEED_100MHZ, AUX_UART1_TX_PIN | AUX_UART1_RX_PIN);
+	gpio_mode_setup(AUX_UART1_PORT, GPIO_MODE_AF, GPIO_PUPD_NONE, AUX_UART1_TX_PIN | AUX_UART1_RX_PIN);
+
+	/* Configure the second UART used for the AUX serial interface */
+	gpio_set_af(AUX_UART2_PORT, GPIO_AF7, AUX_UART2_TX_PIN | AUX_UART2_RX_PIN);
+	gpio_set_output_options(AUX_UART2_PORT, GPIO_OTYPE_PP, GPIO_OSPEED_100MHZ, AUX_UART2_TX_PIN | AUX_UART2_RX_PIN);
+	gpio_mode_setup(AUX_UART2_PORT, GPIO_MODE_AF, GPIO_PUPD_NONE, AUX_UART2_TX_PIN | AUX_UART2_RX_PIN);
+
+	/* Hold the on-board SPI Flash chip select high (deselected) */
+	gpio_set(INT_SPI_CS_PORT, INT_SPI_CS_PIN);
+	gpio_set_output_options(INT_SPI_CS_PORT, GPIO_OTYPE_PP, GPIO_OSPEED_25MHZ, INT_SPI_CS_PIN);
+	gpio_mode_setup(INT_SPI_CS_PORT, GPIO_MODE_OUTPUT, GPIO_PUPD_NONE, INT_SPI_CS_PIN);
+}
+
+int platform_hwversion(void)
+{
+	return 0;
+}
+
+void platform_nrst_set_val(const bool assert)
+{
+	gpio_set_val(NRST_PORT, NRST_PIN, !assert);
+}
+
+bool platform_nrst_get_val(void)
+{
+	/* The pin is open drain, so this reads the actual state of the reset line (asserted = low) */
+	return gpio_get(NRST_PORT, NRST_PIN) == 0U;
+}
+
+const char *platform_target_voltage(void)
+{
+	return "Unknown";
+}
+
+/* Set the bootloader request flag and reset, platform_init() then jumps into the ST ROM bootloader */
+void platform_request_boot(void)
+{
+	magic[0] = BOOTMAGIC0;
+	magic[1] = BOOTMAGIC1;
+	scb_reset_system();
+}
+
+void platform_target_clk_output_enable(const bool enable)
+{
+	/* Convert the TCK/SWCLK pin between tristate and drive */
+	gpio_mode_setup(TCK_PORT, enable ? GPIO_MODE_OUTPUT : GPIO_MODE_INPUT, GPIO_PUPD_NONE, TCK_PIN);
+}
+
+bool platform_spi_init(const spi_bus_e bus)
+{
+	uintptr_t controller;
+	if (bus == SPI_BUS_INTERNAL) {
+		controller = INT_SPI;
+		rcc_set_peripheral_clk_sel(INT_SPI, RCC_CCIPR_SPIxSEL_PCLKx);
+		rcc_periph_clock_enable(RCC_SPI1);
+		gpio_set_af(INT_SPI_SCLK_PORT, GPIO_AF5, INT_SPI_SCLK_PIN);
+		gpio_mode_setup(INT_SPI_SCLK_PORT, GPIO_MODE_AF, GPIO_PUPD_NONE, INT_SPI_SCLK_PIN);
+		gpio_set_af(INT_SPI_POCI_PORT, GPIO_AF5, INT_SPI_POCI_PIN);
+		gpio_mode_setup(INT_SPI_POCI_PORT, GPIO_MODE_AF, GPIO_PUPD_NONE, INT_SPI_POCI_PIN);
+		gpio_set_af(INT_SPI_PICO_PORT, GPIO_AF5, INT_SPI_PICO_PIN);
+		gpio_mode_setup(INT_SPI_PICO_PORT, GPIO_MODE_AF, GPIO_PUPD_NONE, INT_SPI_PICO_PIN);
+		gpio_set(INT_SPI_CS_PORT, INT_SPI_CS_PIN);
+	} else if (bus == SPI_BUS_EXTERNAL) {
+		controller = EXT_SPI;
+		rcc_set_peripheral_clk_sel(EXT_SPI, RCC_CCIPR_SPIxSEL_PCLKx);
+		rcc_periph_clock_enable(RCC_SPI2);
+		gpio_set_af(EXT_SPI_SCLK_PORT, GPIO_AF5, EXT_SPI_SCLK_PIN);
+		gpio_mode_setup(EXT_SPI_SCLK_PORT, GPIO_MODE_AF, GPIO_PUPD_NONE, EXT_SPI_SCLK_PIN);
+		gpio_set_af(EXT_SPI_POCI_PORT, GPIO_AF5, EXT_SPI_POCI_PIN);
+		gpio_mode_setup(EXT_SPI_POCI_PORT, GPIO_MODE_AF, GPIO_PUPD_NONE, EXT_SPI_POCI_PIN);
+		gpio_set_af(EXT_SPI_PICO_PORT, GPIO_AF5, EXT_SPI_PICO_PIN);
+		gpio_mode_setup(EXT_SPI_PICO_PORT, GPIO_MODE_AF, GPIO_PUPD_NONE, EXT_SPI_PICO_PIN);
+		/* The chip select shares the TMS/SWDIO pin, which is normally an input, so make it a deselected output */
+		gpio_set(EXT_SPI_CS_PORT, EXT_SPI_CS_PIN);
+		gpio_mode_setup(EXT_SPI_CS_PORT, GPIO_MODE_OUTPUT, GPIO_PUPD_NONE, EXT_SPI_CS_PIN);
+	} else
+		return false;
+
+	/*
+	 * Run the internal bus at 20MHz (160MHz / 8), and the external bus at 10MHz (160MHz / 16)
+	 * to be kind to flying wires
+	 */
+	const uint32_t baudrate = bus == SPI_BUS_INTERNAL ? SPI_CFG1_MBR_DIV8 : SPI_CFG1_MBR_DIV16;
+	spi_init_master(controller, baudrate, SPI_CFG2_CPOL_CLK_TO_0_WHEN_IDLE, SPI_CFG2_CPHA_CLK_TRANSITION_1,
+		SPI_CFG1_DSIZE_8BIT, SPI_CFG2_MSBFIRST, SPI_CFG2_SP_MOTOROLA);
+	spi_enable(controller);
+
+	if (bus == SPI_BUS_INTERNAL) {
+		/*
+		 * Release the on-board Flash from power-down, should anything have put it there: in power-down it
+		 * ignores every command but this one. Harmless otherwise. tRES1 is 3us, so 1ms is plenty.
+		 */
+		platform_spi_chip_select(SPI_DEVICE_INT_FLASH | 0x80U);
+		platform_spi_xfer(SPI_BUS_INTERNAL, 0xabU);
+		platform_spi_chip_select(SPI_DEVICE_INT_FLASH);
+		platform_delay(1U);
+	}
+	return true;
+}
+
+bool platform_spi_deinit(const spi_bus_e bus)
+{
+	if (bus == SPI_BUS_INTERNAL) {
+		spi_disable(INT_SPI);
+		rcc_periph_clock_disable(RCC_SPI1);
+		/* Release the bus pins, keeping the Flash deselected */
+		gpio_mode_setup(INT_SPI_SCLK_PORT, GPIO_MODE_INPUT, GPIO_PUPD_NONE, INT_SPI_SCLK_PIN);
+		gpio_mode_setup(INT_SPI_POCI_PORT, GPIO_MODE_INPUT, GPIO_PUPD_NONE, INT_SPI_POCI_PIN);
+		gpio_mode_setup(INT_SPI_PICO_PORT, GPIO_MODE_INPUT, GPIO_PUPD_NONE, INT_SPI_PICO_PIN);
+		gpio_set(INT_SPI_CS_PORT, INT_SPI_CS_PIN);
+	} else if (bus == SPI_BUS_EXTERNAL) {
+		spi_disable(EXT_SPI);
+		rcc_periph_clock_disable(RCC_SPI2);
+		/* Return the pins to their debug interface configuration, as set up by gpio_init() */
+		gpio_mode_setup(TCK_PORT, GPIO_MODE_OUTPUT, GPIO_PUPD_NONE, TCK_PIN);
+		gpio_mode_setup(TMS_PORT, GPIO_MODE_INPUT, GPIO_PUPD_NONE, TMS_PIN);
+		gpio_mode_setup(TDI_PORT, GPIO_MODE_OUTPUT, GPIO_PUPD_NONE, TDI_PIN);
+		gpio_mode_setup(TDO_PORT, GPIO_MODE_INPUT, GPIO_PUPD_NONE, TDO_PIN);
+	} else
+		return false;
+	return true;
+}
+
+bool platform_spi_chip_select(const uint8_t device_select)
+{
+	/* Bit 7 set means select, which drives the active low chip select low */
+	const uint8_t device = device_select & 0x7fU;
+	const bool select = !(device_select & 0x80U);
+	uint32_t port;
+	uint16_t pin;
+	switch (device) {
+	case SPI_DEVICE_INT_FLASH:
+		port = INT_SPI_CS_PORT;
+		pin = INT_SPI_CS_PIN;
+		break;
+	case SPI_DEVICE_EXT_FLASH:
+		port = EXT_SPI_CS_PORT;
+		pin = EXT_SPI_CS_PIN;
+		break;
+	default:
+		return false;
+	}
+	gpio_set_val(port, pin, select);
+	return true;
+}
+
+uint8_t platform_spi_xfer(const spi_bus_e bus, const uint8_t value)
+{
+	if (bus == SPI_BUS_INTERNAL)
+		return spi_xfer8(INT_SPI, value);
+	if (bus == SPI_BUS_EXTERNAL)
+		return spi_xfer8(EXT_SPI, value);
+	return 0xffU;
+}
