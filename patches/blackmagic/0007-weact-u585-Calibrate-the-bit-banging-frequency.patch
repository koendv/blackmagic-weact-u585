From 2b8894e7794da6c0f50e369155c5de9e389a7b58 Mon Sep 17 00:00:00 2001
From: Koen De Vleeschauwer <kdv@kdvelectronics.eu>
Date: Sun, 8 Nov 2026 22:32:32 +0100
Subject: [PATCH] weact-u585: Calibrate the bit-banging frequency

`monitor frequency` set and reported the SWD clock with timing_stm32.c's
generic constants, which are for an STM32F103 at 72MHz. On the U585 at
160MHz the real SWCLK was 2 to 4 times lower than reported (e.g. 0.51MHz
for a reported 1.74MHz).

Measured with the CPU cycle counter, an SWD bit takes 35..40 + 40..41 *
divider cycles (depending on code placement in Flash) and ~25 cycles
without delay loops. Use the calibrated frequency support
(BITBANG_CALIBRATED_FREQS, as on BMPv2) with offset 37 and factor 41:
the reported frequency is now within ~6% of the measured SWCLK. JTAG
data shifts carry more per-bit overhead (~83 + 40 * divider cycles), so
JTAG runs slower than reported at small dividers.

timing_stm32.c's calibrated path used rcc_ahb_frequency, which the U5
does not have; use rcc_get_bus_clk_freq(RCC_AHBCLK) there, as the
uncalibrated path already does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/platforms/common/stm32/timing_stm32.c | 13 +++++++++++--
 src/platforms/weact-u585/platform.h       | 13 +++++++++++++
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/src/platforms/common/stm32/timing_stm32.c b/src/platforms/common/stm32/timing_stm32.c
index 3a4e703..619a3b6 100644
--- a/src/platforms/common/stm32/timing_stm32.c
+++ b/src/platforms/common/stm32/timing_stm32.c
@@ -189,6 +189,15 @@ __attribute__((weak)) void platform_ospeed_update(const uint32_t frequency)
 #define USED_SWD_CYCLES 22
 #define CYCLES_PER_CNT  10
 
+#ifdef BITBANG_CALIBRATED_FREQS
+/* The calibration is in CPU cycles: the bit-banging delay loops run at the AHB clock */
+#ifndef STM32U5
+#define BITBANG_CPU_FREQUENCY rcc_ahb_frequency
+#else
+#define BITBANG_CPU_FREQUENCY rcc_get_bus_clk_freq(RCC_AHBCLK)
+#endif
+#endif
+
 void platform_max_frequency_set(const uint32_t frequency)
 {
 	platform_ospeed_update(frequency);
@@ -207,7 +216,7 @@ void platform_max_frequency_set(const uint32_t frequency)
 		 * For everything else, start by dividing the CPU frequency by the requested
 		 * frequency to make a division ratio for the divider
 		 */
-		const uint32_t ratio = rcc_ahb_frequency / frequency;
+		const uint32_t ratio = BITBANG_CPU_FREQUENCY / frequency;
 		/* Then apply the offset and division factor to arrive at a divider value */
 		target_clk_divider = (ratio - BITBANG_DIVIDER_OFFSET) / BITBANG_DIVIDER_FACTOR;
 	}
@@ -242,7 +251,7 @@ uint32_t platform_max_frequency_get(void)
 	 * generated by the bitbanging routines.
 	 */
 	const uint32_t ratio = (target_clk_divider * BITBANG_DIVIDER_FACTOR) + BITBANG_DIVIDER_OFFSET;
-	return rcc_ahb_frequency / ratio;
+	return BITBANG_CPU_FREQUENCY / ratio;
 #else
 #ifndef STM32U5
 	uint32_t result = rcc_ahb_frequency;
diff --git a/src/platforms/weact-u585/platform.h b/src/platforms/weact-u585/platform.h
index f343028..eed5d23 100644
--- a/src/platforms/weact-u585/platform.h
+++ b/src/platforms/weact-u585/platform.h
@@ -234,6 +234,19 @@ extern bool debug_bmp;
 #define SWO_DMA_ISR(x)  gpdma1_ch2_isr(x)
 #define SWO_DMA_REQ_SRC GPDMA1_CxTR2_REQSEL_UART4_RX
 
+/*
+ * Bit-banging frequency calibration, measured with the CPU cycle counter at 160MHz: an SWD bit takes
+ * 35..40 + 40..41 * divider cycles depending on where the code lands in Flash (wait states), and about
+ * 25 cycles with the delay loops left out entirely. The values below sit in the middle, which keeps
+ * the reported frequency within ~6% of the real SWCLK. JTAG data shifts have more overhead per bit
+ * (about 83 + 40 * divider cycles), so JTAG clocks are lower than reported at small dividers.
+ */
+#define BITBANG_CALIBRATED_FREQS
+#define BITBANG_NO_DELAY_FREQ  6500000U
+#define BITBANG_0_DELAY_FREQ   4320000U
+#define BITBANG_DIVIDER_OFFSET 37U
+#define BITBANG_DIVIDER_FACTOR 41U
+
 #define SET_RUN_STATE(state) running_status = (state)
 /* PC13 is active low, so invert the LED states */
 #define SET_IDLE_STATE(state)  gpio_set_val(LED_IDLE_RUN_PORT, LED_IDLE_RUN_PIN, !(state))
-- 
